#!/usr/bin/make -rRf

TARGET = EXE_FILE

%.c: FORCE 
	@ cc $@ -o $(TARGET) -lm && ./$(TARGET) && rm $(TARGET)
	@ valgrind ./$(TARGET)


%.py: FORCE
	@ python3 $@


%.cpp: FORCE
	@ g++ $@ -o $(TARGET) && ./$(TARGET)
	@ rm ./$(TARGET)

%.js %.mjs: FORCE
	@ nodejs $@

%.sh: FORCE
	@ chmod +x $@
	@ $@

%.out: FORCE
	$@

.%: FORCE
	$@

%.go: FORCE
	@ go build -o $(TARGET) $@ && ./$(TARGET) && rm -rf $(TARGET)

%Dockerfile  Dockerfile% %dockerfile: FORCE
	docker build -t somelongname -f $@ . && docker run -it --rm somelongname && docker rmi somelongname 

%/docker-compose.yml  %/docker-compose.yaml: FORCE
	docker-compose up --detach

# you can use file command or something else to that
# or emplement that using c or c++
%.ppm %.png %.jpeg: FORCE
	eog  "$@"

%.php: FORCE
	php  "$@"

.PHONY: FORCE
 FORCE:;
